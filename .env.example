# GEMINI_API_KEY: Diperlukan untuk panggilan API Gemini AI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL tempat applet ini di-hosting.
# Digunakan untuk tautan yang merujuk ke callback OAuth, dan endpoint API.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Kunci API Google Maps Platform untuk peta interaktif real-time dan pelacakan geofence.
VITE_GOOGLE_MAPS_API_KEY="AIzaSyBYManGy_6JJYiGET3u3fl6BQCKsv1N3P8"
VITE_GOOGLE_MAPS_MAP_ID="AIzaSyBYManGy_6JJYiGET3u3fl6BQCKsv1N3P8"

# FIREBASE SDK Web Parental Configuration (untuk frontend FCM Push Notifications)
# Isi value sesuai dengan Firebase Console → Project Settings → Web Apps → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# FCM VAPID Web Push Public Key (sama dengan backend FCM_VAPID_PUBLIC_KEY)
# Generate dari Firebase Console → Cloud Messaging → Web Configuration → Web Push certificates → Key Pair (Public Key)
VITE_FCM_VAPID_PUBLIC_KEY=
